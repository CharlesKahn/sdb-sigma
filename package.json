{
  "name": "sdb-sigma",
  "version": "0.1.0",
  "description": "Audit your agent architecture. Find boundary failures before production does.",
  "bin": {
    "sdb-sigma": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "examples"
  ],
  "scripts": {
    "build": "tsc",
    "check:example": "ts-node src/cli.ts check --config examples/brio-buyer.yaml",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "agent",
    "llm",
    "audit",
    "static-analysis",
    "sdb",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^14.0.3",
    "ora": "^5.4.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
